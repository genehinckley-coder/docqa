@* One finished question: its answer, and the Sources block filled from the quote report. Everything from the model,
   the documents and the store is text, never markup. The styles are in app.css, shared with InProgressView. *@
<article class="qa" aria-labelledby="@QuestionId">
    <div class="qa__eyebrow">Question</div>
    <p id="@QuestionId" class="qa__question">@Record.Question</p>

    <div class="qa__eyebrow qa__eyebrow--answer">Answer</div>
    @if (Record.Segments.Any(segment => segment.Text.Length > 0))
    {
        <AnswerText Segments="Record.Segments" MarkerHref="SourceHref" MarkerLabel="MarkerLabel" />
    }
    else
    {
        <p class="qa__empty">@EmptyText</p>
    }

    @if (Record.Thinking.Length > 0 || Record.HasRedactedThinking)
    {
        <details class="qa__reasoning">
            <summary>Reasoning summary</summary>
            @if (Record.Thinking.Length > 0)
            {
                <p class="qa__reasoning-text">@Record.Thinking</p>
            }
            @if (Record.HasRedactedThinking)
            {
                <p class="qa__reasoning-note">Part of the reasoning was redacted and cannot be shown.</p>
            }
        </details>
    }

    @if (Record.Notice is { } notice)
    {
        <div class="qa__notice">
            <Badge Tone="OutcomeTone" Dot="true">@OutcomeLabel</Badge>
            <span>@notice</span>
        </div>
    }

    @if (Record.Quotes is { Checks.Count: > 0 } quotes)
    {
        <section class="qa__sources" aria-labelledby="@SourcesId">
            <Tooltip Label="Provenance, not entailment">
                <span id="@SourcesId" class="qa__eyebrow qa__eyebrow--help">Sources</span>
            </Tooltip>
            <ol class="qa__source-list">
                @for (int i = 0; i < quotes.Checks.Count; i++)
                {
                    int number = i + 1;
                    QuoteCheck check = quotes.Checks[i];
                    <li id="@SourceId(number)" class="qa__source" tabindex="-1">
                        <span class="qa__source-number" aria-hidden="true">[@number]</span>
                        <span class="qa__source-body">
                            <span class="qa__source-label"><span class="visually-hidden">Source @number: </span>@SourceLabel(check)</span>
                            <span class="qa__source-quote">“@check.CitedText”</span>
                            @if (check.Detail is { } detail)
                            {
                                <span class="qa__source-detail">@detail</span>
                            }
                        </span>
                        <Badge Tone="StatusTone(check.Status)">@check.Status.ToDisplayName()</Badge>
                    </li>
                }
            </ol>
            <p class="qa__quality">@QualityLine(quotes)</p>
            @if (quotes.ThinBlocks is { Count: > 0 } thin)
            {
                <div class="qa__thin">
                    <span class="qa__thin-title">Thinly sourced</span>
                    <ul class="qa__thin-list">
                        @foreach (BlockCoverage block in thin)
                        {
                            <li>“@Excerpt(block.Text)” @Markers(block.SourceNumbers): @Formatting.Percent(block.Fraction) of its text is in matched quotes.</li>
                        }
                    </ul>
                </div>
            }
        </section>
    }

    @if (Record.Warnings.Count > 0)
    {
        <ul class="qa__warnings">
            @foreach (TurnWarning warning in Record.Warnings)
            {
                <li class="qa__warning">
                    <Badge Tone="WarningTone(warning.Kind)" Dot="true">@WarningLabel(warning.Kind)</Badge>
                    <span>@WarningDetail(warning)</span>
                </li>
            }
        </ul>
    }

    @if (ShowDisclaimer)
    {
        <p class="qa__disclaimer">@QuoteChecker.MatchDisclaimer</p>
    }

    <p class="qa__meta">@MetaLine</p>
</article>

@code {
    private const int ExcerptLength = 90;

    private AnswerRecord? _renderedRecord;
    private bool _renderedDisclaimer;
    private string? _renderedBaseUri;
    private bool _changed = true;

    /// <summary>The question and what came of it.</summary>
    [Parameter, EditorRequired]
    public AnswerRecord Record { get; set; } = null!;

    /// <summary>Its position in the conversation, which keeps its element ids unique on the page.</summary>
    [Parameter]
    public int Index { get; set; }

    /// <summary>Whether this is the conversation's first answer with sources, which carries the disclaimer.</summary>
    [Parameter]
    public bool ShowDisclaimer { get; set; }

    /// <summary>The page's address without a fragment, so a marker's link keeps the conversation's query string.</summary>
    [Parameter]
    public string BaseUri { get; set; } = "";

    private string QuestionId => $"answer-{Index}-question";

    private string SourcesId => $"answer-{Index}-sources";

    private string SourceId(int number) => $"answer-{Index}-source-{number}";

    private QuoteCheck? CheckFor(int number) =>
        Record.Quotes is { } quotes && number >= 1 && number <= quotes.Checks.Count ? quotes.Checks[number - 1] : null;

    private string? SourceHref(int number) => CheckFor(number) is null ? null : $"{BaseUri}#{SourceId(number)}";

    private string MarkerLabel(int number) =>
        CheckFor(number) is { } check ? $"Source {number}: {SourceLabel(check)}" : $"Source {number}";

    // The label and character range, as the prototype shows them. No section number: spans can start mid-sentence,
    // even in the previous section's source note, so "the nearest Section heading" could mislabel a legal citation.
    private string SourceLabel(QuoteCheck check)
    {
        if (check.Citation is not { } citation)
        {
            return $"Not a readable citation ({check.CitationType})";
        }

        IReadOnlyList<CorpusDocument> documents = Record.Corpus.Documents;
        string document = citation.DocumentIndex >= 0 && citation.DocumentIndex < documents.Count
            ? documents[(int)citation.DocumentIndex].Label
            : citation.DocumentTitle ?? $"Document {citation.DocumentIndex}";
        return $"{document} · characters {Formatting.Number(citation.StartCharIndex)}–{Formatting.Number(citation.EndCharIndex)}";
    }

    private static BadgeTone StatusTone(MatchStatus status) => status switch
    {
        MatchStatus.Matched => BadgeTone.Success,
        MatchStatus.Mismatch => BadgeTone.Danger,
        _ => BadgeTone.Warning,
    };

    private static string QualityLine(QuoteReport quotes)
    {
        string line = $"{quotes.MatchedCount} of {quotes.Checks.Count} quotes matched";
        return quotes.AnswerCharacters > 0
            ? $"{line}; {Formatting.Percent(quotes.UncitedFraction)} of the answer's text cites nothing."
            : line + ".";
    }

    private static string Markers(IReadOnlyList<int> numbers) => string.Concat(numbers.Select(number => $"[{number}]"));

    private static string Excerpt(string text)
    {
        string flat = string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        if (flat.Length <= ExcerptLength)
        {
            return flat;
        }

        int cut = ExcerptLength - 1;
        if (char.IsHighSurrogate(flat[cut - 1]))
        {
            cut--;
        }

        return flat[..cut].TrimEnd() + "…";
    }

    private static string WarningLabel(TurnWarningKind kind) => kind switch
    {
        TurnWarningKind.Truncated => "TRUNCATED",
        TurnWarningKind.Refused => "REFUSED",
        TurnWarningKind.Incomplete => "INCOMPLETE",
        TurnWarningKind.CacheMiss => "CACHE MISS",
        TurnWarningKind.NotCached => "NOT CACHED",
        TurnWarningKind.Context => "CONTEXT",
        _ => kind.ToString().ToUpperInvariant(),
    };

    private static BadgeTone WarningTone(TurnWarningKind kind) =>
        kind is TurnWarningKind.Incomplete or TurnWarningKind.Context ? BadgeTone.Warning : BadgeTone.Danger;

    // Each warning's text starts with its badge text; the badge already shows it.
    private static string WarningDetail(TurnWarning warning)
    {
        string prefix = WarningLabel(warning.Kind) + ": ";
        return warning.Message.StartsWith(prefix, StringComparison.Ordinal) ? warning.Message[prefix.Length..] : warning.Message;
    }

    private string OutcomeLabel => Record.Outcome switch
    {
        TurnOutcome.Stopped => "STOPPED",
        TurnOutcome.Failed => "FAILED",
        TurnOutcome.NotReplayable => "NOT ADDED",
        _ => "COMPLETED",
    };

    private BadgeTone OutcomeTone => Record.Outcome == TurnOutcome.Failed ? BadgeTone.Danger : BadgeTone.Warning;

    private string EmptyText => Record.Outcome switch
    {
        TurnOutcome.Stopped => "Stopped before any answer text arrived.",
        TurnOutcome.Failed => "No answer text arrived.",
        _ => "The answer carried no text.",
    };

    private string MetaLine
    {
        get
        {
            string settings = Formatting.Settings(Record.Settings);
            if (Record.Result is { } result)
            {
                return string.Join(
                    " · ",
                    settings,
                    Formatting.Money(result.Cost.Total),
                    CacheText(Record.Cache),
                    Formatting.Elapsed(result.Elapsed),
                    $"{Formatting.Number(result.Usage.ContextTokens)} input and {Formatting.Number(result.Usage.Output)} output tokens");
            }

            return settings + " · " + (Record.CostNote ?? (Record.Cost is { } cost ? Formatting.Money(cost.Total) : "cost unknown"));
        }
    }

    private static string CacheText(CacheReport? cache) => cache?.Status switch
    {
        CacheStatus.ColdWrite => "cold cache write",
        CacheStatus.Read => "cache read",
        CacheStatus.Miss => "cache miss",
        CacheStatus.NotCached => "not cached",
        _ => "no cache report",
    };

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        // A finished record never changes, so the page's frequent renders while another answer streams skip it.
        _changed = !ReferenceEquals(Record, _renderedRecord) || ShowDisclaimer != _renderedDisclaimer || BaseUri != _renderedBaseUri;
        _renderedRecord = Record;
        _renderedDisclaimer = ShowDisclaimer;
        _renderedBaseUri = BaseUri;
    }

    /// <inheritdoc/>
    protected override bool ShouldRender() => _changed;
}
