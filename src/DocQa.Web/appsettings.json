{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Never lower this: request headers carry the API key, and bodies carry the whole corpus.
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  // Cache-affecting values (system prompt, labels, TTLs, thinking, models, levels) are compiled
  // constants in DocQa.Core's CacheAffecting class, not settings. Relative paths resolve against
  // this project's folder.
  "DocQa": {
    "CorpusDirectory": "../../admincode",
    "ApiKeyPath": "D:\\claude\\apikeys\\notrag_key.txt",
    "StateFilePath": "../../.docqa_state.json",
    "TokenCeiling": 400000,
    "ContextWindow": 1000000,
    "ContextWarnFraction": 0.70,
    "CacheReadToleranceFraction": 0.01,
    "MinCitationLength": 8,
    "ThinCoverageFraction": 0.50,
    "MaxTokens": {
      "Low": 32000,
      "Medium": 32000,
      "High": 32000,
      "XHigh": 64000,
      "Max": 128000
    },
    // About 2-3x the time an answer at each level's output limit takes at the measured ~95 tokens/s.
    "RequestTimeouts": {
      "Low": "00:20:00",
      "Medium": "00:20:00",
      "High": "00:20:00",
      "XHigh": "00:30:00",
      "Max": "01:00:00"
    },
    // USD per million tokens, from the published pricing page on 2026-09-13. Display only.
    "Prices": {
      "claude-opus-5": {
        "InputPerMTok": 5.00,
        "CacheWrite5mPerMTok": 6.25,
        "CacheWrite1hPerMTok": 10.00,
        "CacheReadPerMTok": 0.50,
        "OutputPerMTok": 25.00
      },
      "claude-sonnet-5": {
        "InputPerMTok": 2.00,
        "CacheWrite5mPerMTok": 2.50,
        "CacheWrite1hPerMTok": 4.00,
        "CacheReadPerMTok": 0.20,
        "OutputPerMTok": 10.00
      }
    },
    // Estimates from the plan's Cost Reference; only High is measured (on Opus 5). Plan item 12
    // replaces them with measurements.
    "EstimatedOutputTokens": {
      "Low": { "Lowest": 800, "Highest": 4300 },
      "Medium": { "Lowest": 1600, "Highest": 5400 },
      "High": { "Lowest": 3200, "Highest": 6400 },
      "XHigh": { "Lowest": 4200, "Highest": 12800 },
      "Max": { "Lowest": 4800, "Highest": 19200 }
    }
  }
}
